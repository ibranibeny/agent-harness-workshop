iagram><diagram name="3 - Bounded agent execution" id="3-bounded-agent-execution"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="input" value="Prompt + completed parent run" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#e8f5e9;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="220" height="80" as="geometry"/></mxCell><mxCell id="context" value="Restore paired history&lt;br&gt;Current system instructions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#ffffff;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="235" height="80" as="geometry"/></mxCell><mxCell id="request" value="Paced Foundry request&lt;br&gt;All enabled tools; plan optional" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#dae8fc;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="90" width="240" height="80" as="geometry"/></mxCell><mxCell id="budget" value="Usage / stop checks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#fff2cc;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="250" height="80" as="geometry"/></mxCell><mxCell id="decision" value="Tool calls?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#fff2cc;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="1025" y="245" width="200" height="110" as="geometry"/></mxCell><mxCell id="final" value="Final answer&lt;br&gt;Persist terminal status" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#e8f5e9;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="470" width="250" height="85" as="geometry"/></mxCell><mxCell id="validate" value="Allowlist + strict schema&lt;br&gt;Prepare exact arguments" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#fff2cc;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="260" width="240" height="85" as="geometry"/></mxCell><mxCell id="write" value="Write?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#fff2cc;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="170" height="110" as="geometry"/></mxCell><mxCell id="read" value="Read tool&lt;br&gt;WebIQ / optional planning" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#e8f5e9;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="230" height="85" as="geometry"/></mxCell><mxCell id="approval" value="Human approves exact proposal?&lt;br&gt;Wait is inside run timeout" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#fff2cc;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="330" y="475" width="245" height="105" as="geometry"/></mxCell><mxCell id="execute" value="Execute approved write&lt;br&gt;PDF / memory / report" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#e8f5e9;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="485" width="240" height="85" as="geometry"/></mxCell><mxCell id="denied" value="Denied observation&lt;br&gt;No write" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#242424;fillColor=#f8cecc;strokeColor=#64748b;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y